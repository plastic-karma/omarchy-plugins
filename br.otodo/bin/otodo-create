#!/usr/bin/env bash
set -euo pipefail

config_file="${OTODO_OMARCHY_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/otodo.json}"

die() {
  printf 'otodo-create: %s\n' "$*" >&2
  exit 1
}

store_root() {
  local configured="~/obs/default/todos"

  if [[ -f "$config_file" ]]; then
    configured="$(jq -er '.storeRoot | strings | select(length > 0)' "$config_file")" \
      || die "invalid storeRoot in $config_file"
  fi

  [[ "$configured" != *$'\n'* && "$configured" != *$'\r'* ]] \
    || die "storeRoot must be a single-line path"

  case "$configured" in
    "~") configured="$HOME" ;;
    "~/"*) configured="$HOME/${configured:2}" ;;
  esac

  [[ "$configured" = /* ]] || die "storeRoot must be absolute or start with ~/"
  printf '%s\n' "$configured"
}

otodo_binary() {
  if [[ -n "${OTODO_BIN:-}" ]]; then
    [[ "$OTODO_BIN" = /* && -x "$OTODO_BIN" ]] \
      || die "OTODO_BIN must name an executable absolute path"
    printf '%s\n' "$OTODO_BIN"
    return
  fi

  if command -v otodo >/dev/null 2>&1; then
    command -v otodo
    return
  fi

  if [[ -x "$HOME/.cargo/bin/otodo" ]]; then
    printf '%s\n' "$HOME/.cargo/bin/otodo"
    return
  fi

  die "otodo is not installed or available on PATH"
}

usage() {
  die "usage: otodo-create --check | --capabilities | --catalog | --parents <query> | --parent <full-id> | --input </list ...|/sync ...> | --add <text> <YYYY-MM-DD|empty> [--due-time <HH:MM>] [--state <id>] [--project <slug>]... [--tag <tag>]... [--url <url>] [--parent <full-id>] [--attach <file>]..."
}

parent_id() {
  local value="$1" LC_ALL=C
  [[ "$value" =~ ^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$ ]] \
    || die "parent must be a full ULID"
  printf '%s\n' "${value^^}"
}

input_line() {
  local value="$1" LC_ALL=C
  [[ ${#value} -le 16384 ]] || die "input must not exceed 16 KiB"
  jq -en --arg value "$value" \
    '$value | explode | all(. >= 32 and (. < 127 or . > 159) and . != 8232 and . != 8233)' \
    >/dev/null || die "input must be one line without control characters"
}

case "${1:-}" in
  --capabilities)
    [[ $# -eq 1 ]] || usage
    cli="$(otodo_binary)"
    exec "$cli" --format json capabilities
    ;;
  --parents)
    [[ $# -eq 2 ]] || usage
    root="$(store_root)"
    cli="$(otodo_binary)"
    exec "$cli" --root "$root" --format json list --all --summary "--query=$2" --limit 25
    ;;
  --parent)
    [[ $# -eq 2 ]] || usage
    parent="$(parent_id "$2")"
    root="$(store_root)"
    cli="$(otodo_binary)"
    exec "$cli" --root "$root" --format json show "$parent"
    ;;
  --check)
    [[ $# -eq 1 ]] || usage
    root="$(store_root)"
    cli="$(otodo_binary)"
    exec "$cli" --root "$root" --format json root
    ;;
  --catalog)
    [[ $# -eq 1 ]] || usage
    root="$(store_root)"
    cli="$(otodo_binary)"
    exec python3 "${BASH_SOURCE[0]%/*}/otodo-catalog.py" "$cli" "$root"
    ;;
  --input)
    [[ $# -eq 2 ]] || usage
    line="$2"
    input_line "$line"
    jq -en --arg line "$line" '$line | test("^\\s*/(list|sync)(\\s|$)")' >/dev/null \
      || die "--input accepts only /list or /sync commands"
    root="$(store_root)"
    cli="$(otodo_binary)"
    # EOF terminates the one line without consuming a byte of the input limit.
    printf '%s' "$line" | "$cli" --root "$root" --format json input
    ;;
  --add)
    [[ $# -ge 3 ]] || usage
    name="$2"
    due_date="$3"
    shift 3
    mutation_args=()
    has_parent=false
    has_state=false
    has_url=false
    has_time=false
    while [[ $# -gt 0 ]]; do
      [[ $# -ge 2 ]] || usage
      case "$1" in
        --parent)
          [[ "$has_parent" = false ]] || usage
          parent="$(parent_id "$2")"
          mutation_args+=(--parent "$parent")
          has_parent=true
          ;;
        --attach)
          [[ -n "$2" ]] || die "attachment path cannot be empty"
          # One array entry preserves literal shell characters and option-like names.
          mutation_args+=("--attach=$2")
          ;;
        --due-time|--state|--url)
          [[ -n "$2" ]] || die "$1 cannot be empty"
          case "$1" in
            --due-time)
              [[ "$has_time" = false && -n "$due_date" ]] || usage
              has_time=true
              ;;
            --state)
              [[ "$has_state" = false ]] || usage
              has_state=true
              ;;
            --url)
              [[ "$has_url" = false ]] || usage
              has_url=true
              ;;
          esac
          mutation_args+=("$1=$2")
          ;;
        --project|--tag)
          [[ -n "$2" ]] || die "$1 cannot be empty"
          mutation_args+=("$1=$2")
          ;;
        *) usage ;;
      esac
      shift 2
    done
    [[ "$name" =~ [^[:space:]] ]] || die "todo text cannot be empty"
    input_line "$name"
    if [[ -n "$due_date" ]]; then
      [[ "$due_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
        || die "date must use YYYY-MM-DD"
      mutation_args+=(--due-date "$due_date")
    fi

    root="$(store_root)"
    cli="$(otodo_binary)"
    exec "$cli" --root "$root" --format json add "${mutation_args[@]}" -- "$name"
    ;;
  *)
    usage
    ;;
esac
